# CPU-only image (no CUDA).
FROM python:3.11-slim

# ffmpeg is required by pydub; libsndfile1 is required by soundfile.
RUN apt-get update && apt-get install -y --no-install-recommends \
        ffmpeg \
        build-essential \
        libsndfile1 \
    && rm -rf /var/lib/apt/lists/*

# uv: fast Python package installer (https://github.com/astral-sh/uv).
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /usr/local/bin/

WORKDIR /opt

ENV UV_LINK_MODE=copy
# uv installs into the system Python interpreter inside the image (no venv).
ENV UV_SYSTEM_PYTHON=1

# Same reasons as the GPU image: a longer read timeout for large wheels, and PyTorch in its own
# layer so a requirements edit does not re-download it.
ENV UV_HTTP_TIMEOUT=300

# Install CPU-only torch/torchaudio wheels (smaller, no CUDA libs) via uv.
RUN uv pip install --system --no-cache \
        --extra-index-url https://download.pytorch.org/whl/cpu \
        torch torchaudio

COPY requirements.txt /opt/requirements.txt
RUN uv pip install --system --no-cache -r requirements.txt

COPY stt_server.py stt_client.py gu.py /opt/
COPY libs /opt/libs
RUN mkdir -p /opt/models /opt/logs /opt/recs

RUN useradd --no-create-home --shell /bin/false stt
RUN chown -R stt:stt /opt

# Start as root: the entrypoint chowns the bind-mounted dirs (the build-time
# chown above cannot reach host-owned mounts) and drops privileges to stt.
COPY entrypoint.sh /opt/entrypoint.sh
RUN chmod +x /opt/entrypoint.sh
ENTRYPOINT ["/opt/entrypoint.sh"]

EXPOSE 5099
CMD ["python", "stt_server.py"]
